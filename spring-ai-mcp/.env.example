# Copy this file to .env and fill in real values.
# docker-compose automatically loads .env.

# --- Instagram OAuth (Meta App) ---
INSTAGRAM_APP_NAME=My Instagram Poster
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Must match a redirect URI registered in the Meta App dashboard exactly.
# In production set this to your real domain.
INSTAGRAM_REDIRECT_URI=http://localhost:8081/instagram/oauth/callback

# --- Optional: pre-issued long-lived token (skip the OAuth flow) ---
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# --- Public URL the Graph API uses to fetch images ---
# Use ngrok or a real domain so api.instagram.com can reach this server.
PUBLIC_BASE_URL=http://localhost:8081

# --- OpenAI (for caption generation) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Watcher tuning (optional) ---
WATCHER_ENABLED=true
WATCHER_POLL_MS=30000

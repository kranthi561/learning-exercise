meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "demo@example.com",
    "password": "password123"
  }
}

script:post-response {
  if (res.status === 200 && res.body && res.body.accessToken) {
    bru.setEnvVar("token", res.body.accessToken);
  }
}

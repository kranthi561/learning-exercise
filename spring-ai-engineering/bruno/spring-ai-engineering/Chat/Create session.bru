meta {
  name: Create session
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/chat/sessions
  body: json
  auth: inherit
}

body:json {
  {
    "title": "My first session"
  }
}

script:post-response {
  if (res.status === 201 && res.body && res.body.id != null) {
    bru.setEnvVar("sessionId", String(res.body.id));
  }
}
